# Copy to .env (or .env.local) and fill in what you have. Every infrastructure
# variable is OPTIONAL — the app runs with embedded/in-process fallbacks when
# unset:
#
#   DATABASE_URL unset  -> embedded PostgreSQL (PGlite) in .data/pglite
#   QDRANT_URL unset    -> in-process cosine-similarity retrieval
#   REDIS_URL unset     -> in-memory cache + rate limiting

# OpenAI (required for AI chat, embeddings, transcription, feedback)
# Get one at https://platform.openai.com/api-keys (starts with "sk-")
OPENAI_API_KEY=

# Firebase web app config (required for signup/login)
# Firebase console -> your project -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PostgreSQL — e.g. local Docker or a free Neon (neon.tech) database
# DATABASE_URL=postgres://aspire:aspire@localhost:5432/aspire

# Qdrant — e.g. local Docker or a free Qdrant Cloud (cloud.qdrant.io) cluster
# After setting these, run: npm run sync:qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Redis — e.g. local Docker or a free Upstash (upstash.com) database
# REDIS_URL=redis://localhost:6379
